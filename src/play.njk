---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}play/"
layout: layouts/base.njk
subpath: "play/"
eleventyComputed:
  pageTitle: "{{ lang.t.game.title }}"
  pageDescription: "{{ lang.t.game.sub | striptags }}"
styles: ["/assets/game/game.css"]
scripts: ["/assets/game/ui.js"]
---
{%- set t = lang.t -%}
{%- set g = lang.t.game -%}

<header class="hero hero-small">
  <div class="wrap">
    {% include "langmenu.njk" %}
    <p class="backlink"><a href="{{ lang.path }}">← {{ g.back }}</a></p>
    <h1>{{ g.h1 }}</h1>
    <p>{{ g.sub }}</p>
  </div>
</header>

<main class="wrap game">
  <!-- 1. Settings -->
  <section id="setup" class="js-only gamebox">
    <h2>{{ g.setupH }}</h2>
    <form id="setup-form">
      <label class="namefield">
        <span>{{ g.yourName }}</span>
        <input type="text" name="player" maxlength="20" autocomplete="given-name" placeholder="{{ g.you }}">
      </label>
      <fieldset>
        <legend>{{ g.bots }}</legend>
        <div class="choices">
          {%- for n in [1, 2, 3, 4] %}
          <label><input type="radio" name="bots" value="{{ n }}"{% if n == 2 %} checked{% endif %}><span>{{ n }}</span></label>
          {%- endfor %}
        </div>
      </fieldset>
      <fieldset>
        <legend>{{ g.level }}</legend>
        <div class="choices">
          <label><input type="radio" name="level" value="easy"><span>{{ g.easy }}</span></label>
          <label><input type="radio" name="level" value="normal" checked><span>{{ g.normal }}</span></label>
        </div>
      </fieldset>
      <button type="submit" class="bigbtn">{{ g.start }}</button>
    </form>
    <div class="statsbox" data-stats></div>
  </section>

  <!-- 2. The table: fills exactly one screen, every area has a fixed size -->
  <section id="table" class="js-only table" hidden>
    <div class="topbar">
      <a href="{{ lang.path }}">← {{ g.back }}</a>
      <span>{{ g.h1 }}</span>
    </div>

    <div id="opponents" class="opponents"></div>

    <div class="center">
      <div class="pilebox">
        <div id="deck" class="pileslot"></div>
        <small>{{ g.deck }}</small>
      </div>
      <div class="pilebox">
        <div id="pile" class="pileslot pile"></div>
        <small>{{ g.pile }}</small>
      </div>
      <div class="pileinfo">
        <span id="burned"></span>
        <small id="invisible"></small>
      </div>
    </div>

    <div class="status" aria-live="polite">
      <p id="status"></p>
      <ol id="log" class="log"></ol>
    </div>

    <div class="me" id="me">
      <div id="my-table" class="mytable" role="group" aria-label="{{ g.yourTable }}"></div>
      <div id="my-hand" class="myhand" role="group" aria-label="{{ g.yourHand }}"></div>
    </div>

    <!-- Flying cards during animations (see fx.js) -->
    <div id="fx" class="fx" aria-hidden="true"></div>

    <div class="controls">
      <button type="button" id="btn-play" class="bigbtn">{{ g.play }}</button>
      <button type="button" id="btn-pickup" class="bigbtn secondary">{{ g.pickUp }}</button>
      <button type="button" id="btn-ready" class="bigbtn ready">{{ g.ready }}</button>
    </div>
  </section>

  <!-- 3. Game over, on top of the table -->
  <section id="over" class="js-only overlay" hidden>
    <div class="gamebox overbox" role="dialog" aria-modal="true" aria-labelledby="over-h">
      <h2 id="over-h">{{ g.overH }}</h2>
      <p id="over-text" class="overtext"></p>
      <ol id="ranking" class="ranking"></ol>
      <div class="overbtns">
        <button type="button" id="btn-again" class="bigbtn">{{ g.again }}</button>
        <button type="button" id="btn-settings" class="bigbtn secondary">{{ g.settings }}</button>
      </div>
      <div class="statsbox" data-stats></div>
    </div>
  </section>

  <script type="application/json" id="game-text">{{ g | dump | safe }}</script>
</main>

<footer>{{ t.foot | safe }}</footer>
