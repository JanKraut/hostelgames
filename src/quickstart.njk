---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}quickstart/"
layout: layouts/base.njk
subpath: "quickstart/"
eleventyComputed:
  pageTitle: "{{ lang.t.pgQuick }} · {{ lang.t.title }}"
  pageDescription: "{{ lang.t.sub | striptags }}"
---
{#- Same header as the rules page; the cheat sheet below fits on one phone screen. -#}
{%- set t = lang.t -%}

{% include "hero.njk" %}

<main class="wrap quick">
  {%- if t.info %}
  {% include "factsheet.njk" %}
  {%- endif %}

  <section id="spickzettel">
    <div class="cheat">
      <h2>{{ t.chH }}</h2>
      <dl>
        <dt>{{ t.c1t }}</dt><dd>{{ t.c1d | safe }}</dd>
        <dt>{{ t.c2t }}</dt><dd>{{ t.c2d | safe }}</dd>
        <dt>{{ t.c3t }}</dt><dd>{{ t.c3d | safe }}</dd>
        <dt>2</dt><dd>{{ t.c4d | safe }}</dd>
        <dt>3</dt><dd>{{ t.c5d | safe }}</dd>
        <dt>7</dt><dd>{{ t.c6d | safe }}</dd>
        <dt>8</dt><dd>{{ t.c8bd | safe }}</dd>
        <dt>10</dt><dd>{{ t.c7d | safe }}</dd>
        <dt>4×</dt><dd>{{ t.c8d | safe }}</dd>
        <dt>{{ t.c9t }}</dt><dd>{{ t.c9d | safe }}</dd>
      </dl>
    </div>
  </section>
</main>
