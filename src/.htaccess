# Hetzner webspace (Apache). Only copied into the build for the Hetzner deploy.

# Always use HTTPS and the domain without www.
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://shitheadgame.de%{REQUEST_URI} [R=301,L]

AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  # Fonts, images and scripts may be cached for a week …
  <FilesMatch "\.(woff2|png|svg|ico|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # … but pages, the manifest and the service worker are always revalidated,
  # so every deploy reaches visitors.
  <FilesMatch "(\.html|\.webmanifest|^sw\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
