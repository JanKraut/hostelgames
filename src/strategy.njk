---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}strategy/"
layout: layouts/base.njk
subpath: "strategy/"
eleventyComputed:
  pageTitle: "{{ lang.t.stH }} · {{ lang.t.title }}"
  pageDescription: "{{ lang.t.stLead | striptags }}"
classicScripts: ["/assets/qrcode.js"]
scripts: ["/assets/share.js"]
---
{%- set t = lang.t -%}

{% include "hero.njk" %}

<main class="wrap">
  <section id="strategie">
    <h2>{{ t.stH }}</h2>
    <p class="lead">{{ t.stLead | safe }}</p>
    <ul class="strats">
      {%- for i in range(1, 8) %}
      <li><h3>{{ t["t" + i + "h"] }}</h3><p>{{ t["t" + i + "p"] | safe }}</p></li>
      {%- endfor %}
    </ul>
  </section>
  {% include "share.njk" %}
</main>

{% include "footer.njk" %}
