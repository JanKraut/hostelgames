{#- Fact sheet at the top of the quick start: who, how long, what you need.
    Only shown for languages that have the `info` texts (for now German). -#}
{%- set i = lang.t.info -%}
{%- set people -%}
<svg class="fs-people" viewBox="0 0 32 24" aria-hidden="true"><circle cx="11" cy="7" r="4"/><path d="M3 21c0-4.5 3.6-7 8-7s8 2.5 8 7"/><circle cx="21" cy="6" r="3.5"/><path d="M19 13.2c.6-.1 1.3-.2 2-.2 4.4 0 8 2.5 8 7"/></svg>
{%- endset -%}
<section id="steckbrief" class="factsheet" aria-labelledby="fs-h">
  <div class="fs-top">
    <h2 id="fs-h">{{ i.title }}</h2>
    <p class="fs-bubble">{{ i.tagline }}</p>
  </div>

  <div class="fs-grid">
    <div class="fs-box fs-scales">
      {%- for s in [[i.luck, i.skill, 55], [i.easy, i.complex, 25], [i.kids, i.adults, 25]] %}
      <div class="fs-scale" role="img" aria-label="{{ s[0] }} – {{ s[1] }}">
        <span>{{ s[0] }}</span><span class="fs-bar" style="--v: {{ s[2] }}%" aria-hidden="true"></span><span>{{ s[1] }}</span>
      </div>
      {%- endfor %}
    </div>

    <div class="fs-box">
      <h3>{{ i.playersH }}</h3>
      <div class="fs-players">
        <div class="fs-group" role="img" aria-label="{{ i.players1 }}: {{ i.decks1 }}">
          <div class="fs-who">{{ people | safe }}<span>{{ i.players1 }}</span></div>
          <div class="fs-decks"><span class="fs-deck"></span></div>
        </div>
        <div class="fs-group" role="img" aria-label="{{ i.players2 }}: {{ i.decks2 }}">
          <div class="fs-who">{{ people | safe }}<span>{{ i.players2 }}</span></div>
          <div class="fs-decks"><span class="fs-deck"></span><span class="fs-deck alt"></span></div>
        </div>
      </div>
    </div>

    <div class="fs-box fs-pair">
      <div>
        <h3>{{ i.timeH }}</h3>
        <div class="fs-clock"><b>{{ i.timeN }}</b><small>{{ i.timeU }}</small></div>
      </div>
      <div>
        <h3>{{ i.similarH }}</h3>
        <ul class="fs-similar">
          {%- for name in i.similar.split(", ") %}
          <li>{{ name }}</li>
          {%- endfor %}
        </ul>
      </div>
    </div>

    <div class="fs-box">
      <h3>{{ i.cardsH }}</h3>
      <div class="fs-cards" role="img" aria-label="{{ i.cardsAlt }}">
        <span class="fs-mini">A</span><span class="fs-arrow" aria-hidden="true">→</span><span class="fs-mini">K</span>
        <span class="fs-mini fs-joker">{{ i.joker }}</span>
        <span class="fs-count">{{ i.cardsN }}</span>
      </div>
    </div>
  </div>

  <div class="fs-intro">
    <h3>{{ i.introH }}</h3>
    <p>{{ i.intro | safe }}</p>
  </div>
</section>
