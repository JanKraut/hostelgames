{#- Shared frame for every page. Pages set: subpath ("" or "play/"), pageTitle,
    pageDescription, and optionally styles, classicScripts and scripts (ES modules),
    as lists of /assets/… paths. site.js (language menu, offline) is always loaded. -#}
{%- set sub = subpath or "" -%}
<!DOCTYPE html>
<html lang="{{ lang.htmlLang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ lang.url }}{{ sub }}">
{%- for l in languages %}
<link rel="alternate" hreflang="{{ l.htmlLang }}" href="{{ l.url }}{{ sub }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ languages[0].url }}{{ sub }}">
<script>document.documentElement.classList.add("js");try{var th=localStorage.getItem("theme");if(th==="light"||th==="dark")document.documentElement.dataset.theme=th}catch(e){}</script>
{%- if lang.path == "/" %}
<script>{% include "redirect.njk" %}</script>
{%- endif %}
{%- include "tracking-head.njk" %}
<meta name="theme-color" content="#f4cf71" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#171a1f" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
{#- Fetch the main font files right away instead of after the CSS is parsed. #}
<link rel="preload" href="/assets/fonts/manrope-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/manrope-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/fonts.css">
<link rel="stylesheet" href="/assets/styles.css">
{%- for href in styles %}
<link rel="stylesheet" href="{{ href }}">
{%- endfor %}
{%- for src in classicScripts %}
<script src="{{ src }}" defer></script>
{%- endfor %}
<script type="module" src="/assets/site.js"></script>
{%- for src in scripts %}
<script type="module" src="{{ src }}"></script>
{%- endfor %}
</head>
<body>
{%- include "tracking-body.njk" %}
{{ content | safe }}
</body>
</html>
