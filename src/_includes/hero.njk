{#- Big header with title, intro and goal. Shared by the rules page, the quick start and
    the strategy page; the rules page adds its fact sheet below the goal, the strategy
    page has its own title and intro. -#}
{%- from "card.njk" import card, shithead -%}
{%- set t = lang.t -%}
<header class="hero">
  <div class="wrap">
    {% include "langmenu.njk" %}
    {% include "pagenav.njk" %}
    {%- set strat = subpath == "strategy/" %}
    <h1>{{ (t.strategy.h1 if strat else t.h1) | safe }}</h1>
    <p>{{ (t.strategy.sub if strat else t.sub) | safe }}</p>
    <div class="fan" aria-hidden="true">
      {{ card("2", "♣") }}
      {{ card("10", "♥") }}
      {{ card("7", "♠") }}
      {{ shithead() }}
    </div>
    <div class="goal">
      <div class="goal-icon" aria-hidden="true">🎯</div>
      <p>{{ t.goal | safe }}</p>
    </div>
    {%- if not subpath %}
    {% include "factsheet.njk" %}
    {%- endif %}
  </div>
</header>
