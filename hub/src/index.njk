---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}"
layout: layouts/hub.njk
share: true
eleventyComputed:
  pageTitle: "{{ lang.t.seo.title }}"
  pageDescription: "{{ lang.t.seo.description }}"
---
{#- Start page, one per language (languages in hub/hub.json). Names and taglines of the games
    come from games.<slug> in the hub's i18n, otherwise from the game's game.json. -#}
{%- from "sharebox.njk" import sharebox -%}
{%- set t = lang.t -%}
<header class="hero">
  <div class="wrap">
    <div class="hubtop">
      <a class="hublogo" href="{{ lang.path }}">{% include "logo.njk" %}</a>
      {% include "langmenu.njk" %}
    </div>
    {#- Logo swings down a little once the page is scrolled (see .is-scrolled in hub.css) -#}
    <script type="module">
      const root = document.documentElement;
      const update = () => root.classList.toggle("is-scrolled", window.scrollY > 24);
      update();
      addEventListener("scroll", update, { passive: true });
    </script>
    <h1>{{ t.h1 }}</h1>
    <p>{{ t.sub }}</p>
  </div>
</header>

<main class="wrap hub">
  {#- One section per category (src/_data/categories.js: order from CATEGORIES in core,
      games by "category" in their game.json).
      A category without games yet still shows, with a short "coming soon" line. -#}
  <nav class="cats" aria-label="{{ t.catsNav }}">
    {%- for cat in categories %}
    <a href="#{{ cat.key }}">{{ t.categories[cat.key].name }}</a>
    {%- endfor %}
  </nav>
  {%- for cat in categories %}
  {%- set ct = t.categories[cat.key] %}
  <section class="cat" id="{{ cat.key }}" aria-labelledby="{{ cat.key }}-h">
  <h2 id="{{ cat.key }}-h">{{ ct.name }}</h2>
  <p class="cat-lead">{{ ct.lead }}</p>
  {%- if not cat.games.length %}
  <p class="cat-soon">{{ t.catSoon }}</p>
  {%- else %}
  <ul class="games">
    {%- for game in cat.games %}
    {%- set gt = t.games[game.slug] or {} %}
    {#- Same language on the game's site, if the game has it. -#}
    {%- set langPath = lang.path | replace("/", "", 1) if (lang.code in game.languages) else "" %}
    <li>
      {#- Live on hostelgames.com: link to the game's own domain. In the preview (GitHub Pages)
          the games are built next to the hub, under /<path>/. -#}
      <a class="game" href="{{ (game.domain + '/' if (site.indexable and game.domain) else '/' + game.path + '/') + langPath }}">
        <span class="game-name">{{ gt.name or game.name }}</span>
        {%- if gt.tagline or game.tagline %}
        <span class="game-tagline">{{ gt.tagline or game.tagline }}</span>
        {%- endif %}
        <span class="game-meta">
          {{- t.mLanguages | replace("{n}", game.languages.length) }}
          {%- if "play" in game.pages %} · {{ t.mBots }}{% endif %}
          {%- if game.players %} · {{ t.mPlayers | replace("{min}", game.players.min) | replace("{max}", game.players.max) }}{% endif %}
          {%- if game.duration %} · {{ game.duration }}{% endif %}
        </span>
        {%- if "scoresheet" in game.pages %}
        <span class="game-sheet">{{ t.mSheet }}</span>
        {%- endif %}
        {%- if game.status == "draft" %}
        <span class="game-draft">{{ t.draft }}</span>
        {%- endif %}
      </a>
      {#- Online-Block (page "scoresheet" in game.json): extra link straight to it. -#}
      {%- if "scoresheet" in game.pages %}
      <a class="game-extra" href="{{ (game.domain + '/' if (site.indexable and game.domain) else '/' + game.path + '/') + langPath }}scoresheet/">{{ t.sheetOpen }}</a>
      {%- endif %}
    </li>
    {%- endfor %}
  </ul>
  {%- endif %}
  </section>
  {%- endfor %}
</main>

{#- Popup of the QR button in the top bar (langmenu.njk, share.js). -#}
<dialog class="qrpop" aria-labelledby="qrpop-h">
  <div class="sharebox">
    <button type="button" class="qrclose" aria-label="{{ t.shClose }}" title="{{ t.shClose }}">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    {{ sharebox(t, lang.url) }}
  </div>
</dialog>

{% include "footer.njk" %}
