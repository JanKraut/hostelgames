---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}"
layout: game
share: true
eleventyComputed:
  pageTitle: "{{ lang.t.seo.rulesT }}"
  pageDescription: "{{ lang.t.seo.rulesD }}"
---
{%- from "blocks.njk" import secnav, steps, variants, faq, sheetCta -%}
{#- Rules page, one per language. Sections follow the course of a round:
    setup, card values, one turn, card powers, stacking, calling Cambio, scoring,
    then variants and FAQ. Texts in src/_data/i18n, styles in src/assets/styles.css. -#}
{%- from "card.njk" import card, back, stack, cardRow -%}
{%- set t = lang.t -%}
{%- set r = t.rules -%}
{% include "hero.njk" %}

{{ secnav(t.navLabel, [
  ["setup", r.nSetup],
  ["values", r.nValues],
  ["turn", r.nTurn],
  ["powers", r.nPowers],
  ["stacking", r.nStacking],
  ["cambio", r.nCambio],
  ["scoring", r.nScoring],
  ["variants", r.nVar],
  ["faq", r.nFaq]
]) }}

<main class="wrap">

  <section id="setup">
    <h2>{{ r.setupH }}</h2>
    <p class="lead">{{ r.setupLead | safe }}</p>

    {#- Dealing: four cards face down in a square. Only the two near you are
        peeked at once (shown face up and outlined). -#}
    <div class="grid4vis" role="img" aria-label="{{ r.setupAlt }}">
      <p class="g4-note g4-far">{{ r.setupFar | safe }}</p>
      <div class="g4">
        {{ back("sm") }}{{ back("sm") }}
        {{ card("8", "♠", "sm", "gold") }}{{ card("3", "♦", "sm", "gold") }}
      </div>
      <p class="g4-note g4-near">{{ r.setupNear | safe }}</p>
    </div>

    {{ steps(r, "setupS") }}
  </section>

  <section id="values">
    <h2>{{ r.valuesH }}</h2>
    <p class="lead">{{ r.valuesLead | safe }}</p>
    <ul class="values">
      <li>{{ card("★", "", "sm", "joker", pip=false) }}<b>0</b><span>{{ r.valuesJoker }}</span></li>
      <li>{{ card("K", "♥", "sm") }}<b>−1</b><span>{{ r.valuesRedKing }}</span></li>
      <li>{{ card("A", "♠", "sm") }}<b>1</b><span>{{ r.valuesAce }}</span></li>
      <li><div class="v-pair">{{ card("2", "♣", "sm") }}{{ card("10", "♦", "sm") }}</div><b>2–10</b><span>{{ r.valuesNumber }}</span></li>
      <li><div class="v-pair">{{ card("J", "♣", "sm") }}{{ card("Q", "♥", "sm") }}</div><b>10</b><span>{{ r.valuesFace }}</span></li>
      <li>{{ card("K", "♠", "sm") }}<b>10</b><span>{{ r.valuesBlackKing }}</span></li>
    </ul>
    <p>{{ r.valuesP | safe }}</p>
  </section>

  <section id="turn">
    <h2>{{ r.turnH }}</h2>
    <h3 class="sub first">{{ r.turnStartH }}</h3>
    <p>{{ r.turnStartP | safe }}</p>

    <h3 class="sub">{{ r.turnOneH }}</h3>
    <div class="decide">
      <p class="dq">{{ r.turnDq }}</p>
      <p class="dqs">{{ r.turnDqs | safe }}</p>
      <div class="branches">
        <div class="br keep-br">
          <div class="bh">{{ r.turnKeepH }}</div>
          <p class="bp">{{ r.turnKeepP | safe }}</p>
        </div>
        <div class="br drop-br">
          <div class="bh">{{ r.turnDropH }}</div>
          <p class="bp">{{ r.turnDropP | safe }}</p>
        </div>
      </div>
      <p class="dnext">{{ r.turnNext | safe }}</p>
    </div>
    <p>{{ r.turnMemo | safe }}</p>
  </section>

  <section id="powers">
    <h2>{{ r.powersH }}</h2>
    <p class="lead">{{ r.powersLead | safe }}</p>
    <div class="specials">
      <div class="sp"><div class="v-pair">{{ card("7", "♥", "xs") }}{{ card("8", "♣", "xs") }}</div><div><h3>{{ r.powersPeekH }}</h3><p>{{ r.powersPeekP | safe }}</p></div></div>
      <div class="sp"><div class="v-pair">{{ card("9", "♠", "xs") }}{{ card("10", "♦", "xs") }}</div><div><h3>{{ r.powersSpyH }}</h3><p>{{ r.powersSpyP | safe }}</p></div></div>
      <div class="sp"><div class="v-pair">{{ card("J", "♦", "xs") }}{{ card("Q", "♠", "xs") }}</div><div><h3>{{ r.powersBlindH }}</h3><p>{{ r.powersBlindP | safe }}</p></div></div>
      <div class="sp"><div class="v-pair">{{ card("K", "♣", "xs") }}{{ card("K", "♠", "xs") }}</div><div><h3>{{ r.powersLookH }}</h3><p>{{ r.powersLookP | safe }}</p></div></div>
    </div>
    <p class="sp-extra">{{ r.powersNote | safe }}</p>
  </section>

  <section id="stacking">
    <h2>{{ r.stackingH }}</h2>
    <p class="lead">{{ r.stackingLead | safe }}</p>
    {#- A 6 lies on the discard pile; a known 6 from a hand goes on top. -#}
    <div class="stackvis" role="img" aria-label="{{ r.stackingAlt }}">
      <div class="sv-pile">
        {{ card("6", "♣", "sm") }}
        <p class="dv-note">{{ r.stackingPile | safe }}</p>
      </div>
      <svg class="sv-arrow" viewBox="0 0 64 40" aria-hidden="true"><path d="M60 30 C 44 6, 24 4, 8 16"/><path d="M17 10 L7 17 L19 21"/></svg>
      <div class="sv-pile">
        {{ card("6", "♥", "sm", "gold") }}
        <p class="dv-note">{{ r.stackingMine | safe }}</p>
      </div>
    </div>
    <ul class="variants">
      <li>{{ r.stackingOwn | safe }}</li>
      <li>{{ r.stackingOther | safe }}</li>
      <li>{{ r.stackingWrong | safe }}</li>
    </ul>
    <p>{{ r.stackingP | safe }}</p>
  </section>

  <section id="cambio">
    <h2>{{ r.cambioH }}</h2>
    <p class="lead">{{ r.cambioLead | safe }}</p>
    {{ steps(r, "cambioS") }}
    <h3 class="sub">{{ r.cambioTieH }}</h3>
    <p>{{ r.cambioTieP | safe }}</p>
    <h3 class="sub">{{ r.cambioEmptyH }}</h3>
    <p>{{ r.cambioEmptyP | safe }}</p>
  </section>

  <section id="scoring">
    <h2>{{ r.scoringH }}</h2>
    <p class="lead">{{ r.scoringLead | safe }}</p>
    {#- Example hand: A + 3 + red king + 7 = 10 points. -#}
    <div class="sumvis" role="img" aria-label="{{ r.scoringAlt }}">
      <div class="sum-cards">
        <div class="sum-c">{{ card("A", "♦", "xs") }}<b>1</b></div>
        <span class="sum-op" aria-hidden="true">+</span>
        <div class="sum-c">{{ card("3", "♠", "xs") }}<b>3</b></div>
        <span class="sum-op" aria-hidden="true">+</span>
        <div class="sum-c">{{ card("K", "♥", "xs") }}<b>−1</b></div>
        <span class="sum-op" aria-hidden="true">+</span>
        <div class="sum-c">{{ card("7", "♣", "xs") }}<b>7</b></div>
      </div>
      <p class="sum-total">= 10 {{ r.scoringPoints }}</p>
    </div>
    <p>{{ r.scoringP | safe }}</p>

    {#- Hinweis auf den Online-Block (scoresheet/) -#}
    {{ sheetCta(lang.path + "scoresheet/", r.sheetCta, r.sheetCtaBtn) }}
  </section>

  {{ variants(r) }}

  {{ faq(r) }}

  {% include "share.njk" %}
</main>

{% include "footer.njk" %}
