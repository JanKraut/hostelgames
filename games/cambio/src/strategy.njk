---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}strategy/"
layout: game
subpath: "strategy/"
share: true
eleventyComputed:
  pageTitle: "{{ lang.t.seo.strategyT }}"
  pageDescription: "{{ lang.t.seo.strategyD }}"
---
{%- from "blocks.njk" import secnav, strats, mistakes, nextSteps -%}
{#- Strategieseite für Cambio (52 + 2 Joker, roter König −1, schwarzer König anschauen & tauschen,
    Abwerfen eigener und fremder Karten, gesperrte Karten nach „Cambio“). Kein Spiel gegen Bots. -#}
{%- from "card.njk" import card -%}
{%- set t = lang.t -%}
{%- set s = t.strategy -%}
{% include "hero.njk" %}

{{ secnav(t.navLabel, [
  ["principle", s.principleNav],
  ["memory", s.memNav],
  ["powers", s.powNav],
  ["stacking", s.stackNav],
  ["calling", s.callNav],
  ["mistakes", s.mistakesNav]
]) }}

<main class="wrap">
  <section id="principle">
    <h2>{{ s.principleH }}</h2>
    <p class="lead">{{ s.principle | safe }}</p>
    {{ strats(s.principleItems) }}
  </section>

  <section id="memory">
    <h2>{{ s.memH }}</h2>
    <p class="lead">{{ s.memLead | safe }}</p>
    {{ strats(s.memItems) }}
  </section>

  <section id="powers">
    <h2>{{ s.powH }}</h2>
    <p class="lead">{{ s.powLead | safe }}</p>
    <div class="specials">
      <div class="sp"><div class="v-pair">{{ card("7", "♥", "xs") }}{{ card("8", "♣", "xs") }}</div><div><h3>{{ s.pow7h }}</h3><p>{{ s.pow7p | safe }}</p></div></div>
      <div class="sp"><div class="v-pair">{{ card("9", "♠", "xs") }}{{ card("10", "♦", "xs") }}</div><div><h3>{{ s.pow9h }}</h3><p>{{ s.pow9p | safe }}</p></div></div>
      <div class="sp"><div class="v-pair">{{ card("J", "♦", "xs") }}{{ card("Q", "♠", "xs") }}</div><div><h3>{{ s.powJh }}</h3><p>{{ s.powJp | safe }}</p></div></div>
      <div class="sp"><div class="v-pair">{{ card("K", "♣", "xs") }}{{ card("K", "♠", "xs") }}</div><div><h3>{{ s.powKh }}</h3><p>{{ s.powKp | safe }}</p></div></div>
    </div>
  </section>

  <section id="stacking">
    <h2>{{ s.stackH }}</h2>
    <p class="lead">{{ s.stackLead | safe }}</p>

    {#- Beispiel für fremdes Abwerfen: fremde 6 auf die offene 6 legen, eigene Dame (10) rübergeben. -#}
    <figure class="crossvis">
      <figcaption>{{ s.crossH }}</figcaption>
      <div class="cv-steps" role="img" aria-label="{{ s.crossAlt }}">
        <div class="cv-step">
          {{ card("6", "♣", "xs") }}
          <p>{{ s.cross1 | safe }}</p>
        </div>
        <span class="cv-arrow" aria-hidden="true">→</span>
        <div class="cv-step">
          {{ card("6", "♥", "xs", "gold") }}
          <p>{{ s.cross2 | safe }}</p>
        </div>
        <span class="cv-arrow" aria-hidden="true">→</span>
        <div class="cv-step">
          {{ card("Q", "♠", "xs") }}
          <p>{{ s.cross3 | safe }}</p>
        </div>
      </div>
      <p>{{ s.crossWhy | safe }}</p>
    </figure>

    {{ strats(s.stackItems) }}
    <p class="notup">{{ s.stackWarn | safe }}</p>
  </section>

  <section id="calling">
    <h2>{{ s.callH }}</h2>
    <p class="lead">{{ s.callLead | safe }}</p>
    {{ strats(s.callItems) }}
  </section>

  {{ mistakes(s) }}

  {{ nextSteps([
    [s.ctaQuickH, s.ctaQuickP, lang.path + "quickstart/", s.ctaQuickBtn],
    [s.ctaRulesH, s.ctaRulesP, lang.path, s.ctaRulesBtn]
  ]) }}

  {% include "share.njk" %}
</main>

{% include "footer.njk" %}
