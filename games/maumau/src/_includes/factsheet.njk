{#- Fact sheet in the rules page header: who, how long, what you need.
    Same layout as King’s Cup (games/kingscup/src/_includes/factsheet.njk), with cards only.
    Texts: `info` in the game's i18n. -#}
{%- from "card.njk" import card -%}
{%- set i = lang.t.info -%}
<section id="factsheet" class="factsheet" aria-label="{{ i.label }}">
  <div class="fs-grid">
    <div class="fs-box fs-scales">
      {%- for s in [[i.luck, i.skill, 40], [i.easy, i.complex, 15], [i.kids, i.adults, 25]] %}
      <div class="fs-scale" role="img" aria-label="{{ s[0] }} – {{ s[1] }}">
        <span>{{ s[0] }}</span><span class="fs-bar" style="--v: {{ s[2] }}%" aria-hidden="true"></span><span>{{ s[1] }}</span>
      </div>
      {%- endfor %}
    </div>

    <div class="fs-box">
      <h2>{{ i.playersH }}</h2>
      <div class="fs-players">
        <div class="fs-group" role="img" aria-label="{{ i.players1 }}: {{ i.mode1 }}">
          <svg class="fs-people" viewBox="0 0 32 24" aria-hidden="true"><circle cx="11" cy="7" r="4"/><path d="M3 21c0-4.5 3.6-7 8-7s8 2.5 8 7"/><circle cx="21" cy="6" r="3.5"/><path d="M19 13.2c.6-.1 1.3-.2 2-.2 4.4 0 8 2.5 8 7"/></svg>
          <div class="fs-who"><b>{{ i.players1 }}</b><span>{{ i.mode1 }}</span></div>
        </div>
        <div class="fs-group" role="img" aria-label="{{ i.players2 }}: {{ i.mode2 }}">
          <svg class="fs-people" viewBox="0 0 32 24" aria-hidden="true"><circle cx="6" cy="8" r="3.2"/><path d="M0.5 21c0-3.8 2.5-6 5.5-6s5.5 2.2 5.5 6"/><circle cx="16" cy="6" r="3.8"/><path d="M9.5 21c0-4.3 2.9-7 6.5-7s6.5 2.7 6.5 7"/><circle cx="26" cy="8" r="3.2"/><path d="M20.5 21c0-3.8 2.5-6 5.5-6s5.5 2.2 5.5 6"/></svg>
          <div class="fs-who"><b>{{ i.players2 }}</b><span>{{ i.mode2 }}</span></div>
        </div>
      </div>
    </div>

    <div class="fs-box fs-pair">
      <div>
        <h2>{{ i.timeH }}</h2>
        <div class="fs-clock"><b>{{ i.timeN }}</b><small>{{ i.timeU }}</small></div>
      </div>
      <div>
        <h2>{{ i.similarH }}</h2>
        <ul class="fs-similar">
          {%- for name in i.similar.split(", ") %}
          <li>{{ name }}</li>
          {%- endfor %}
        </ul>
      </div>
    </div>

    <div class="fs-box">
      <h2>{{ i.gearH }}</h2>
      <div class="fs-gear" role="img" aria-label="{{ i.gearAlt }}">
        <span class="fs-cards">{{ card("7", "♥", "xs") }}{{ card("J", "♣", "xs") }}</span>
        <span class="fs-count">{{ i.gearN }}</span>
      </div>
    </div>
  </div>

  <div class="fs-intro">
    <h2>{{ i.introH }}</h2>
    <p>{{ i.intro | safe }}</p>
  </div>
</section>
