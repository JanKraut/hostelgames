---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}"
layout: game
share: true
eleventyComputed:
  pageTitle: "{{ lang.t.seo.rulesT }}"
  pageDescription: "{{ lang.t.seo.rulesD }}"
---
{#- Rules page, one per language. Texts in src/_data/i18n/*.json (keys under "rules"),
    playing cards from the core macros in card.njk. -#}
{%- from "card.njk" import card, back, cardRow -%}
{%- set t = lang.t -%}
{%- set r = t.rules -%}
<header class="hero">
  <div class="wrap">
    {% include "langmenu.njk" %}
    {% include "pagenav.njk" %}
    <h1>{{ r.h1 }}<span class="h1-sub"> {{ r.h1sub }}</span></h1>
    <p>{{ t.sub | safe }}</p>
    <div class="fan" aria-hidden="true">
      {{ card("7", "♣") }}
      {{ card("10", "♦") }}
      {{ card("K", "♠") }}
      {{ card("A", "♥") }}
    </div>
    <div class="goal">
      <div class="goal-icon" aria-hidden="true">🎯</div>
      <p>{{ r.goal | safe }}</p>
    </div>
  </div>
</header>

<nav class="secnav" aria-label="{{ r.navLabel }}">
  <ul>
    <li><a href="#setup">{{ r.nSetup }}</a></li>
    <li><a href="#how-to-play">{{ r.nPlay }}</a></li>
    <li><a href="#ranks">{{ r.nRanks }}</a></li>
    <li><a href="#swap">{{ r.nSwap }}</a></li>
    <li><a href="#variants">{{ r.nVar }}</a></li>
    <li><a href="#faq">{{ r.nFaq }}</a></li>
  </ul>
</nav>

<main class="wrap">

  <section id="setup">
    <h2>{{ r.setupH }}</h2>
    <p class="lead">{{ r.setupLead | safe }}</p>
    <ul class="decks">
      <li><b>{{ r.deck1n }}</b><span>{{ r.deck1 | safe }}</span></li>
      <li><b>{{ r.deck2n }}</b><span>{{ r.deck2 | safe }}</span></li>
    </ul>

    <h3 class="sub">{{ r.rankH }}</h3>
    <p class="lead">{{ r.rankLead | safe }}</p>
    {#- 32-card pack: 7 lowest, ace highest. -#}
    <div class="ranks" role="img" aria-label="{{ r.rankAlt }}">
      {{ cardRow([["7","♣"],["8","♥"],["9","♠"],["10","♦"],["J","♣"],["Q","♥"],["K","♠"],["A","♦"]]) }}
    </div>
    <div class="rankscale" aria-hidden="true"><span>{{ r.rankLow }}</span><span>{{ r.rankHigh }}</span></div>
    <p>{{ r.rankP | safe }}</p>

    <h3 class="sub">{{ r.dealH }}</h3>
    <p>{{ r.dealP | safe }}</p>
  </section>

  <section id="how-to-play">
    <h2>{{ r.playH }}</h2>

    <h3 class="sub first">{{ r.startH }}</h3>
    <p>{{ r.startP | safe }}</p>

    <h3 class="sub">{{ r.turnH }}</h3>
    <ol class="steps">
      <li><h3>{{ r.t1h }}</h3><p>{{ r.t1p | safe }}</p></li>
      <li><h3>{{ r.t2h }}</h3><p>{{ r.t2p | safe }}</p></li>
      <li><h3>{{ r.t3h }}</h3><p>{{ r.t3p | safe }}</p></li>
    </ol>

    {#- What may go on a pair of nines: a higher pair yes, a single ace or three of a kind no. -#}
    <div class="check">
      <p class="ck-q">{{ r.ckQ | safe }}</p>
      <div class="ck-row">
        <div class="ck ck-top">
          <div class="ck-cards" aria-hidden="true">{{ card("9", "♠", "xs", pip=false) }}{{ card("9", "♥", "xs", pip=false) }}</div>
          <p>{{ r.ckTop }}</p>
        </div>
        <div class="ck ck-yes">
          <div class="ck-cards" aria-hidden="true">{{ card("J", "♦", "xs", pip=false) }}{{ card("J", "♣", "xs", pip=false) }}</div>
          <p><b>✓</b> {{ r.ckYes }}</p>
        </div>
        <div class="ck ck-no">
          <div class="ck-cards" aria-hidden="true">{{ card("A", "♣", "xs", pip=false) }}</div>
          <p><b>✗</b> {{ r.ckNo1 }}</p>
        </div>
        <div class="ck ck-no">
          <div class="ck-cards" aria-hidden="true">{{ card("Q", "♠", "xs", pip=false) }}{{ card("Q", "♥", "xs", pip=false) }}{{ card("Q", "♦", "xs", pip=false) }}</div>
          <p><b>✗</b> {{ r.ckNo2 }}</p>
        </div>
      </div>
    </div>

    <h3 class="sub">{{ r.trickH }}</h3>
    <p>{{ r.trickP | safe }}</p>
    {#- One trick, move by move. Dana's kings are not beaten, she wins the trick. -#}
    <ol class="trick" aria-label="{{ r.trickAlt }}">
      {%- for m in [
        [r.pA, [["8","♣"],["8","♥"]]],
        [r.pB, [["10","♠"],["10","♦"]]],
        [r.pC, []],
        [r.pD, [["K","♣"],["K","♥"]]],
        [r.pA, []],
        [r.pB, []],
        [r.pC, []]
      ] %}
      <li class="{{ 'tr-pass' if not m[1].length }}{{ ' tr-win' if loop.index == 4 }}">
        <span class="tr-who">{{ m[0] }}</span>
        {%- if m[1].length %}
        <span class="tr-cards" aria-hidden="true">{% for c in m[1] %}{{ card(c[0], c[1], "xs", pip=false) }}{% endfor %}</span>
        <span class="tr-what">{{ m[1][0][0] }} {{ m[1][1][0] }}</span>
        {%- else %}
        <span class="tr-what">{{ r.pass }}</span>
        {%- endif %}
      </li>
      {%- endfor %}
    </ol>
    <p class="tr-note">{{ r.trickNote | safe }}</p>

    <h3 class="sub">{{ r.outH }}</h3>
    <p>{{ r.outP | safe }}</p>
  </section>

  <section id="ranks">
    <h2>{{ r.ranksH }}</h2>
    <p class="lead">{{ r.ranksLead | safe }}</p>
    <ol class="ladder">
      {%- for i in [1, 2, 3, 4, 5] %}
      <li class="ld ld{{ i }}">
        <span class="ld-icon" aria-hidden="true">{{ ["👑", "🎩", "🧑‍🌾", "😬", "🍑"][i - 1] }}</span>
        <span class="ld-name">{{ r["rk" ~ i] }}</span>
        <span class="ld-when">{{ r["rk" ~ i ~ "w"] }}</span>
      </li>
      {%- endfor %}
    </ol>
    <p>{{ r.ranksP | safe }}</p>

    <h3 class="sub">{{ r.endH }}</h3>
    <p>{{ r.endP | safe }}</p>

    <h3 class="sub">{{ r.gameH }}</h3>
    <p>{{ r.gameP | safe }}</p>
  </section>

  <section id="swap">
    <h2>{{ r.swH }}</h2>
    <p class="lead">{{ r.swLead | safe }}</p>
    {#- The asshole hands over the two highest cards, the king gives back two he chooses. -#}
    <div class="give" role="img" aria-label="{{ r.swAlt }}">
      <div class="gv">
        <p class="gv-who"><span aria-hidden="true">🍑</span> {{ r.rk5 }} <span class="gv-arrow" aria-hidden="true">→</span> <span aria-hidden="true">👑</span> {{ r.rk1 }}</p>
        <div class="gv-cards">{{ card("A", "♠", "sm", "gold") }}{{ card("K", "♥", "sm", "gold") }}</div>
        <p class="gv-what">{{ r.swGive }}</p>
      </div>
      <div class="gv">
        <p class="gv-who"><span aria-hidden="true">👑</span> {{ r.rk1 }} <span class="gv-arrow" aria-hidden="true">→</span> <span aria-hidden="true">🍑</span> {{ r.rk5 }}</p>
        <div class="gv-cards">{{ card("7", "♦", "sm") }}{{ card("8", "♣", "sm") }}</div>
        <p class="gv-what">{{ r.swBack }}</p>
      </div>
    </div>

    <ol class="steps">
      <li><h3>{{ r.s1h }}</h3><p>{{ r.s1p | safe }}</p></li>
      <li><h3>{{ r.s2h }}</h3><p>{{ r.s2p | safe }}</p></li>
      <li><h3>{{ r.s3h }}</h3><p>{{ r.s3p | safe }}</p></li>
      <li><h3>{{ r.s4h }}</h3><p>{{ r.s4p | safe }}</p></li>
    </ol>
    <p>{{ r.swWhy | safe }}</p>
  </section>

  <section id="variants">
    <h2>{{ r.varH }}</h2>
    <p class="lead">{{ r.varLead | safe }}</p>
    <ul class="variants">
      {%- for i in range(1, 11) %}
      <li>{{ r["var" ~ i] | safe }}</li>
      {%- endfor %}
    </ul>
  </section>

  <section id="faq">
    <h2>{{ r.faqH }}</h2>
    <div class="faq">
      {%- for i in range(1, 8) %}
      <details>
        <summary>{{ r["faq" ~ i ~ "q"] }}</summary>
        <p>{{ r["faq" ~ i ~ "a"] | safe }}</p>
      </details>
      {%- endfor %}
    </div>
  </section>

  {% include "share.njk" %}
</main>

{% include "footer.njk" %}
