---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}strategy/"
layout: game
subpath: "strategy/"
share: true
eleventyComputed:
  pageTitle: "{{ lang.t.seo.strategyT }}"
  pageDescription: "{{ lang.t.seo.strategyD }}"
---
{%- from "blocks.njk" import secnav, strats, mistakes, nextSteps -%}
{#- Strategieseite für Cabo (52er-Blatt, rote Könige 0, schwarze 13, Multi-Tausch,
    Ansager darf im letzten Zug noch getauscht werden). Kein Spiel gegen Bots. -#}
{%- from "card.njk" import card, back -%}
{%- set t = lang.t -%}
{%- set s = t.strategy -%}
{% include "hero.njk" %}

{{ secnav(t.navLabel, [
  ["principle", s.principleNav],
  ["memory", s.memNav],
  ["drawing", s.drawNav],
  ["powers", s.powNav],
  ["multiswap", s.multiNav],
  ["calling", s.callNav],
  ["mistakes", s.mistakesNav]
]) }}

<main class="wrap">
  <section id="principle">
    <h2>{{ s.principleH }}</h2>
    <p class="lead">{{ s.principle | safe }}</p>
    {{ strats(s.principleItems) }}
  </section>

  <section id="memory">
    <h2>{{ s.memH }}</h2>
    <p class="lead">{{ s.memLead | safe }}</p>

    {#- Merkhilfe: das 2×2-Quadrat immer in fester Reihenfolge als vierstelligen Code lesen. -#}
    <figure class="memvis">
      <figcaption>{{ s.memExH }}</figcaption>
      <div class="mv-pair" role="img" aria-label="{{ s.memExAlt }}">
        <div class="mv-panel">
          <p class="mv-title">{{ s.memBefore }}</p>
          <div class="mv-grid">
            {{ back("xs") }}{{ back("xs") }}
            {{ card("4", "♥", "xs") }}{{ card("9", "♠", "xs") }}
          </div>
          <p class="mv-code">? · ? · 4 · 9</p>
        </div>
        <svg class="mv-arrow" viewBox="0 0 48 48" aria-hidden="true"><path d="M8 24 H38"/><path d="M28 13 L40 24 L28 35"/></svg>
        <div class="mv-panel">
          <p class="mv-title">{{ s.memAfter }}</p>
          <div class="mv-grid">
            {{ card("2", "♦", "xs", "gold") }}{{ back("xs") }}
            {{ card("4", "♥", "xs") }}{{ card("9", "♠", "xs") }}
          </div>
          <p class="mv-code"><b>2</b> · ? · 4 · 9</p>
        </div>
      </div>
      <p>{{ s.memExWhy | safe }}</p>
    </figure>

    {{ strats(s.memItems) }}
  </section>

  <section id="drawing">
    <h2>{{ s.drawH }}</h2>
    <p class="lead">{{ s.drawLead | safe }}</p>
    {{ strats(s.drawItems) }}
    <p class="notup">{{ s.drawWarn | safe }}</p>
  </section>

  <section id="powers">
    <h2>{{ s.powH }}</h2>
    <p class="lead">{{ s.powLead | safe }}</p>
    <div class="specials">
      <div class="sp">
        <div class="pair">{{ card("7", "♣", "xs") }}{{ card("8", "♦", "xs") }}</div>
        <div><h3>{{ s.pow7h }}</h3><p>{{ s.pow7p | safe }}</p></div>
      </div>
      <div class="sp">
        <div class="pair">{{ card("9", "♥", "xs") }}{{ card("10", "♠", "xs") }}</div>
        <div><h3>{{ s.pow9h }}</h3><p>{{ s.pow9p | safe }}</p></div>
      </div>
      <div class="sp">
        <div class="pair">{{ card("J", "♠", "xs") }}{{ card("Q", "♥", "xs") }}</div>
        <div><h3>{{ s.powJh }}</h3><p>{{ s.powJp | safe }}</p></div>
      </div>
      <div class="sp">
        <div class="pair">{{ card("K", "♥", "xs", "gold") }}{{ card("K", "♠", "xs") }}</div>
        <div><h3>{{ s.powKh }}</h3><p>{{ s.powKp | safe }}</p></div>
      </div>
    </div>
  </section>

  <section id="multiswap">
    <h2>{{ s.multiH }}</h2>
    <p class="lead">{{ s.multiLead | safe }}</p>
    {{ strats(s.multiItems) }}
  </section>

  <section id="calling">
    <h2>{{ s.callH }}</h2>
    <p class="lead">{{ s.callLead | safe }}</p>
    {{ strats(s.callItems) }}
  </section>

  {{ mistakes(s) }}

  {{ nextSteps([
    [s.ctaQuickH, s.ctaQuickP, lang.path + "quickstart/", s.ctaQuickBtn],
    [s.ctaRulesH, s.ctaRulesP, lang.path, s.ctaRulesBtn]
  ]) }}

  {% include "share.njk" %}
</main>

{% include "footer.njk" %}
