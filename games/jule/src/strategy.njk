---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}strategy/"
layout: game
subpath: "strategy/"
share: true
eleventyComputed:
  pageTitle: "{{ lang.t.seo.strategyT }}"
  pageDescription: "{{ lang.t.seo.strategyD }}"
---
{%- from "blocks.njk" import secnav, strats, mistakes, nextSteps -%}
{#- Strategieseite für Jule: ehrlich über reines Würfelglück, echte Wahrscheinlichkeiten
    mit Würfeln aus dice.njk, Taktik für die Stumme Jule, passende Varianten und Fehler. -#}
{%- from "dice.njk" import die, dice -%}
{%- set t = lang.t -%}
{%- set s = t.strategy -%}
{% include "hero.njk" %}

{{ secnav(t.navLabel, [
  ["principle", s.principleNav],
  ["odds", s.oddsNav],
  ["silent-tactics", s.silentNav],
  ["variants-guide", s.varNav],
  ["mistakes", s.mistakesNav]
]) }}

<main class="wrap">
  <section id="principle">
    <h2>{{ s.principleH }}</h2>
    <p class="lead">{{ s.principle | safe }}</p>
    {{ strats(s.principleItems) }}
  </section>

  <section id="odds">
    <h2>{{ s.oddsH }}</h2>
    <p class="lead">{{ s.oddsLead | safe }}</p>
    {#- Exakte Wahrscheinlichkeiten für Jule und Varianten (1/6 ≈ 17 %, 1−(5/6)³ ≈ 42 %,
        (5/6)⁶ ≈ 33 %, 1/36 ≈ 3 %, 6/36 ≈ 17 %). -#}
    <ul class="odds" role="list">
      {%- for o in [
        [[[1, "held"]], "17 %"],
        [[[3, "held"], 0, 0], "42 %"],
        [[[6, "held"], [6, "held"]], "3 %"],
        [[0], "33 %"],
        [[[1, "held"], [1, "held"]], "3 %"],
        [[[3, "held"], [4, "held"]], "17 %"]
      ] %}
      <li>
        {{ dice(o[0], "xs") }}
        <span class="odds-goal">{{ s.odds[loop.index0] }}</span>
        <b class="odds-pct">{{ o[1] }}</b>
      </li>
      {%- endfor %}
    </ul>
    <p class="note">{{ s.oddsNote | safe }}</p>
    {{ strats(s.oddsItems) }}
  </section>

  <section id="silent-tactics">
    <h2>{{ s.silentH }}</h2>
    <p class="lead">{{ s.silentLead | safe }}</p>
    {{ strats(s.silentItems) }}
    <p class="notup">{{ s.silentWarn | safe }}</p>
  </section>

  <section id="variants-guide">
    <h2>{{ s.varH }}</h2>
    <p class="lead">{{ s.varLead | safe }}</p>
    {{ strats(s.varItems) }}
  </section>

  {{ mistakes(s) }}

  {{ nextSteps([
    [s.ctaQuickH, s.ctaQuickP, lang.path + "quickstart/", s.ctaQuickBtn],
    [s.ctaRulesH, s.ctaRulesP, lang.path, s.ctaRulesBtn]
  ]) }}

  {% include "share.njk" %}
</main>

{% include "footer.njk" %}
