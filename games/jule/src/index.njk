---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}"
layout: game
share: true
eleventyComputed:
  pageTitle: "{{ lang.t.seo.rulesT }}"
  pageDescription: "{{ lang.t.seo.rulesD }}"
---
{#- Regelseite, eine pro Sprache. Abschnitte von oben nach unten: Aufbau, Dein Zug,
    Rückweg, Gewinnen, Stumme Jule, Varianten, FAQ, Teilen. Texte in src/_data/i18n/*.json. -#}
{%- from "dice.njk" import die, dice -%}
{%- set t = lang.t -%}
{% include "hero.njk" %}

<nav class="secnav" aria-label="{{ t.navLabel }}">
  <ul>
    <li><a href="#setup">{{ t.nSetup }}</a></li>
    <li><a href="#turn">{{ t.nTurn }}</a></li>
    <li><a href="#back">{{ t.nBack }}</a></li>
    <li><a href="#winning">{{ t.nWin }}</a></li>
    <li><a href="#silent">{{ t.nSilent }}</a></li>
    <li><a href="#variants">{{ t.nVariants }}</a></li>
    <li><a href="#faq">{{ t.nFaq }}</a></li>
  </ul>
</nav>

<main class="wrap">

  <section id="setup">
    <h2>{{ t.setupH }}</h2>
    <p class="lead">{{ t.setupLead | safe }}</p>
    <ul class="rules">
      <li>{{ t.setup1 | safe }}</li>
      <li>{{ t.setup2 | safe }}</li>
      <li>{{ t.setup3 | safe }}</li>
    </ul>
    <p>{{ t.setupP | safe }}</p>
  </section>

  <section id="turn">
    <h2>{{ t.turnH }}</h2>
    <p class="lead">{{ t.turnLead | safe }}</p>
    <ol class="steps">
      <li><h3>{{ t.s1h }}</h3><p>{{ t.s1p | safe }}</p></li>
      <li><h3>{{ t.s2h }}</h3><p>{{ t.s2p | safe }}</p></li>
      <li><h3>{{ t.s3h }}</h3><p>{{ t.s3p | safe }}</p></li>
    </ol>

    {#- Beispielrunde: Anna braucht die 3, Ben die 1, Cem die 5. Gold = Treffer, wird notiert. -#}
    <h3 class="sub">{{ t.exH }}</h3>
    <div class="rolls" role="img" aria-label="{{ t.exAlt }}">
      {%- for r in [[t.pA, 3, 3], [t.pB, 1, 4], [t.pC, 5, 5], [t.pA, 4, 2]] %}
      <div class="roll{% if r[1] == r[2] %} hit{% endif %}">
        <p class="roll-n">{{ r[0] }}</p>
        <span class="roll-need">{{ t.exNeed }} {{ r[1] }}</span>
        {{ die(r[2], "sm", "held" if r[1] == r[2] else "") }}
        <span class="roll-res">{{ t.exHit if r[1] == r[2] else t.exMiss }}</span>
      </div>
      {%- endfor %}
    </div>
    <p>{{ t.exP | safe }}</p>
  </section>

  <section id="back">
    <h2>{{ t.backH }}</h2>
    <p class="lead">{{ t.backLead | safe }}</p>
    {#- Zettel von Anna: Hinweg komplett, auf dem Rückweg 6 und 5 schon gestrichen. -#}
    <figure class="jsheet" role="img" aria-label="{{ t.sheetAlt }}">
      <p class="js-name">{{ t.pA }}</p>
      <div class="js-row">
        <span class="js-label">{{ t.sheetUp }} →</span>
        <ol class="js-nums">
          {%- for n in range(1, 7) %}<li class="done">{{ n }}</li>{% endfor -%}
        </ol>
      </div>
      <div class="js-row">
        <span class="js-label">← {{ t.sheetDown }}</span>
        <ol class="js-nums">
          {%- for n in [6, 5, 4, 3, 2, 1] %}<li class="{{ 'struck' if n > 4 else ('next' if n == 4 else '') }}">{{ n }}</li>{% endfor -%}
        </ol>
      </div>
      <figcaption>{{ t.sheetNote }}</figcaption>
    </figure>
    <p>{{ t.backP | safe }}</p>
  </section>

  <section id="winning">
    <h2>{{ t.winH }}</h2>
    <p class="lead">{{ t.winLead | safe }}</p>
    <h3 class="sub">{{ t.scoreH }}</h3>
    <p>{{ t.scoreP | safe }}</p>
    <ul class="rules">
      <li>{{ t.score1 | safe }}</li>
      <li>{{ t.score2 | safe }}</li>
    </ul>
  </section>

  <section id="silent">
    <h2>{{ t.silentH }}</h2>
    <p class="lead">{{ t.silentLead | safe }}</p>
    <div class="silent">
      <div class="silent-icon" aria-hidden="true">🤫</div>
      <ul class="rules">
        <li>{{ t.silent1 | safe }}</li>
        <li>{{ t.silent2 | safe }}</li>
        <li>{{ t.silent3 | safe }}</li>
      </ul>
    </div>
    <p>{{ t.silentP | safe }}</p>
  </section>

  <section id="variants">
    <h2>{{ t.varH }}</h2>
    <p class="lead">{{ t.varLead | safe }}</p>
    <ul class="variants">
      {%- for i in range(1, 7) %}
      <li>{{ t["var" ~ i] | safe }}</li>
      {%- endfor %}
    </ul>
  </section>

  <section id="faq">
    <h2>{{ t.faqH }}</h2>
    <div class="faq">
      {%- for i in range(1, 7) %}
      <details>
        <summary>{{ t["faq" ~ i ~ "q"] }}</summary>
        <p>{{ t["faq" ~ i ~ "a"] | safe }}</p>
      </details>
      {%- endfor %}
    </div>
  </section>

  {% include "share.njk" %}
</main>

{% include "footer.njk" %}
