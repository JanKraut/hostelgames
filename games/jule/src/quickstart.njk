---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}quickstart/"
layout: game
subpath: "quickstart/"
share: true
eleventyComputed:
  pageTitle: "{{ lang.t.seo.quickT }}"
  pageDescription: "{{ lang.t.seo.quickD }}"
---
{#- Quickstart: kompakter Spickzettel für Jule – Grundregel, Hin- und Rückweg mit
    Würfeln, Umdrehen & Gewinnen, Stumme Jule. Texte unter `quick`. -#}
{%- from "blocks.njk" import nextSteps -%}
{%- from "dice.njk" import die -%}
{%- set t = lang.t -%}
{%- set k = t.quick -%}
{% include "hero.njk" %}

<main class="wrap quick">
  <section id="cheat-sheet">
    <div class="cheat cheat2">
      <h2>{{ k.h }}</h2>

      <div class="ch-block ch-rule">
        <div class="ch-icon" aria-hidden="true">1×</div>
        <div><h3>{{ k.ruleH }}</h3><p>{{ k.rule | safe }}</p></div>
      </div>

      <div class="ch-block">
        <h3>{{ k.pathH }}</h3>
        <div class="ch-path" role="img" aria-label="{{ k.pathAlt }}">
          <div class="ch-row">
            <span class="ch-dir">{{ t.rules.sheetUp }} →</span>
            <span class="ch-dice">{%- for n in range(1, 7) %}{{ die(n, "fs") }}{% endfor -%}</span>
          </div>
          <div class="ch-row">
            <span class="ch-dir">← {{ t.rules.sheetDown }}</span>
            <span class="ch-dice">{%- for n in [6, 5, 4, 3, 2, 1] %}{{ die(n, "fs") }}{% endfor -%}</span>
          </div>
        </div>
        <p class="ch-note">{{ k.turnaround | safe }}</p>
      </div>

      <div class="ch-block">
        <h3>{{ t.rules.winH }}</h3>
        <p>{{ k.win | safe }}</p>
      </div>

      <div class="ch-block ch-rule">
        <div class="ch-icon ch-emoji" aria-hidden="true">🤫</div>
        <div><h3>{{ t.rules.silentH }}</h3><p>{{ k.silent | safe }}</p></div>
      </div>
    </div>
  </section>

  {{ nextSteps([
    [k.ctaStratH, k.ctaStratP, lang.path + "strategy/", k.ctaStratBtn],
    [k.ctaRulesH, k.ctaRulesP, lang.path, k.ctaRulesBtn]
  ]) }}

  {% include "share.njk" %}
</main>

{% include "footer.njk" %}
