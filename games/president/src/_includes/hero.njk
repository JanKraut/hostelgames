{#- Big header with title, intro, fanned cards and goal. Shared by the rules page
    and the strategy page; the strategy page gets its own title and intro. -#}
{%- from "card.njk" import card -%}
{%- set t = lang.t -%}
{%- set strat = subpath == "strategy/" -%}
<header class="hero">
  <div class="wrap">
    {% include "sitehead.njk" %}
    {%- if strat %}
    <h1>{{ t.strategy.h1 }}</h1>
    <p>{{ t.strategy.sub | safe }}</p>
    {%- else %}
    <h1>{{ t.h1 }}<span class="h1-sub"> {{ t.h1sub }}</span></h1>
    <p>{{ t.sub | safe }}</p>
    {%- endif %}
    <div class="fan" aria-hidden="true">
      {{ card("3", "♣") }}
      {{ card("9", "♦") }}
      {{ card("A", "♥") }}
      {{ card("2", "♠") }}
    </div>
    <div class="goal">
      <div class="goal-icon" aria-hidden="true">🎯</div>
      <p>{{ t.goal | safe }}</p>
    </div>
  </div>
</header>
