# Hetzner webspace (Apache). Only copied into the build for the Hetzner deploy.

# Always use HTTPS and the domain without www.
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://shitheadgame.de%{REQUEST_URI} [R=301,L]

AddType application/manifest+json .webmanifest

# Our own error page for addresses that don't exist.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Fonts and images may be cached for a week …
  <FilesMatch "\.(woff2|png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # … but pages, CSS, scripts, the manifest and the service worker are always
  # revalidated (cheap thanks to ETags), so every deploy reaches visitors.
  <FilesMatch "\.(html|css|js|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
