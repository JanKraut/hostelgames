{#- A playing card. size: "" | "sm" | "xs"; extra: more classes, e.g. "gold". -#}
{% macro card(rank, suit, size="", extra="", pip=true) -%}
<div class="card{% if suit == '♥' or suit == '♦' %} r{% endif %}{% if size %} {{ size }}{% endif %}{% if extra %} {{ extra }}{% endif %}"><div class="c">{{ rank }}<span>{{ suit }}</span></div>{% if pip %}<div class="pip">{{ suit }}</div>{% endif %}</div>
{%- endmacro %}

{% macro back(size="sm") -%}
<div class="card {{ size }} back"></div>
{%- endmacro %}

{#- Face-down card with a face-up card on top. -#}
{% macro stack(rank, suit, extra="") -%}
<div class="stack">{{ back() }}{{ card(rank, suit, "sm", extra) }}</div>
{%- endmacro %}

{#- A row of overlapping cards, left to right. Cards are [rank, suit, extra?]. -#}
{% macro cardRow(cards, size="") -%}
{%- for c in cards %}{{ card(c[0], c[1], size, c[2]) }}{% endfor -%}
{%- endmacro %}

{#- The Shithead card: the pile from the favicon instead of rank and suit. -#}
{% macro shithead(size="", label="Shithead") -%}
{%- set pile -%}
<svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#7a4520" d="M24 4c1 3.5-1 5.5-3.5 6.8C16.6 12.6 14 15.4 14 18.6c0 .6.1 1.1.2 1.6C9.8 21.6 7 24.6 7 28.2c0 1 .2 2 .7 2.9C3.8 32.5 1 35.6 1 39.2 1 43.5 4.8 46 10 46h28c5.2 0 9-2.5 9-6.8 0-3.6-2.8-6.7-6.7-8.1.5-.9.7-1.9.7-2.9 0-3.6-2.8-6.6-7.2-8 .1-.5.2-1 .2-1.6 0-4.4-4-7.8-8.6-8.4C26.3 9.4 25.6 6.8 24 4z"/><path fill="#9a5d32" d="M9 33.4c4.8 2 25.2 2 30 0-.3 1.6-6 3-15 3s-14.7-1.4-15-3zM14.6 22.4c4 1.6 14.8 1.6 18.8 0-.3 1.4-4.2 2.6-9.4 2.6s-9.1-1.2-9.4-2.6z"/><ellipse cx="17" cy="16.5" rx="2.4" ry="1.4" fill="#b07444" opacity=".7"/><circle cx="18.5" cy="30" r="3.4" fill="#fff"/><circle cx="29.5" cy="30" r="3.4" fill="#fff"/><circle cx="19.2" cy="30.6" r="1.7" fill="#1a1d21"/><circle cx="30.2" cy="30.6" r="1.7" fill="#1a1d21"/><path d="M18.5 37.5q5.5 3.6 11 0" fill="none" stroke="#3d2310" stroke-width="1.7" stroke-linecap="round"/></svg>
{%- endset -%}
<div class="card sh{% if size %} {{ size }}{% endif %}"><div class="c">{{ pile | safe }}</div><div class="c c2">{{ pile | safe }}</div><div class="pip">{{ pile | safe }}<b>{{ label }}</b></div></div>
{%- endmacro %}
