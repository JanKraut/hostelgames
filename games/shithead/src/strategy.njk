---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}strategy/"
layout: game
subpath: "strategy/"
share: true
eleventyComputed:
  pageTitle: "{{ lang.t.seo.strategyT }}"
  pageDescription: "{{ lang.t.seo.strategyD }}"
---
{%- from "blocks.njk" import secnav, strats, mistakes, nextSteps -%}
{%- from "card.njk" import card, stack -%}
{%- set t = lang.t -%}
{%- set s = t.strategy -%}

{#- Hand fan for the swap example: three small cards, swapped ones outlined. -#}
{%- macro fan(cards) -%}
<div class="dv-fan">{% for c in cards %}{{ card(c[0], c[1], "sm", c[2]) }}{% endfor %}</div>
{%- endmacro -%}

{% include "hero.njk" %}

{%- set navItems = [["principle", s.principleNav], ["swap", s.swapNav]] -%}
{%- for phase in s.phases %}{% set navItems = (navItems.push([phase.id, phase.h]), navItems) %}{% endfor -%}
{%- set navItems = (navItems.push(["using-special-cards", s.spNav], ["mistakes", s.mistakesNav], [lang.path + "play/", t.game.ctaBtn]), navItems) -%}
{{ secnav(t.navLabel, navItems) }}

<main class="wrap">
  <section id="principle">
    <h2>{{ s.principleH }}</h2>
    <p class="lead">{{ s.principle | safe }}</p>
  </section>

  <section id="swap">
    <h2>{{ s.swapH }}</h2>
    <p class="lead">{{ s.swapLead | safe }}</p>
    <h3 class="sub first">{{ s.upH }}</h3>
    {{ strats(s.up) }}
    <p class="notup">{{ s.notUp | safe }}</p>

    {#- Swap example: before and after. 10 and king from the hand change places
        with 4 and 8 on the table (outlined). -#}
    <figure class="swapex">
      <figcaption>{{ s.exH }}</figcaption>
      <div class="sx-pair" role="img" aria-label="{{ s.exAlt }}">
        <div class="sx-panel">
          <p class="sx-title">{{ s.exBefore }}</p>
          <p class="sx-label">{{ s.exHand }}</p>
          {{ fan([["10", "♥", "gold"], ["K", "♠", "gold"], ["5", "♣"]]) }}
          <p class="sx-label">{{ s.exUp }}</p>
          <div class="dv-table">{{ stack("4", "♦", "gold") }}{{ stack("8", "♣", "gold") }}{{ stack("Q", "♥") }}</div>
        </div>
        <svg class="sx-arrow" viewBox="0 0 48 48" aria-hidden="true"><path d="M8 24 H38"/><path d="M28 13 L40 24 L28 35"/></svg>
        <div class="sx-panel">
          <p class="sx-title">{{ s.exAfter }}</p>
          <p class="sx-label">{{ s.exHand }}</p>
          {{ fan([["4", "♦", "gold"], ["8", "♣", "gold"], ["5", "♣"]]) }}
          <p class="sx-label">{{ s.exUp }}</p>
          <div class="dv-table">{{ stack("10", "♥", "gold") }}{{ stack("K", "♠", "gold") }}{{ stack("Q", "♥") }}</div>
        </div>
      </div>
      <p>{{ s.exWhy | safe }}</p>
      <div class="sx-variant">
        <div class="sx-mini" role="img" aria-label="{{ s.exVariantAlt }}">{{ card("10", "♥", "xs") }}{{ card("6", "♠", "xs") }}{{ card("6", "♦", "xs") }}</div>
        <p>{{ s.exVariant | safe }}</p>
      </div>
    </figure>
  </section>

  {%- for phase in s.phases %}

  <section id="{{ phase.id }}">
    <h2>{{ phase.h }}</h2>
    {{ strats(phase.items) }}
  </section>
  {%- endfor %}

  <section id="using-special-cards">
    <h2>{{ s.spH }}</h2>
    <p class="lead">{{ s.spLead | safe }}</p>
    <div class="specials">
      {%- set suits = { "2": "♣", "3": "♥", "7": "♠", "8": "♥", "10": "♦" } %}
      {%- for sp in s.sp %}
      <div class="sp">
        {%- if sp.rank == "four" %}
        <div class="four">
          {%- for suit in ["♠", "♥", "♣", "♦"] %}
          {{ card("9", suit, "xs") }}
          {%- endfor %}
        </div>
        {%- else %}
        {{ card(sp.rank, suits[sp.rank], "sm") }}
        {%- endif %}
        <div>
          <h3>{{ sp.h }}</h3>
          <p>{{ sp.p | safe }}</p>
          {%- if sp.items %}
          <ul class="sp-list">
            {%- for item in sp.items %}
            <li>{{ item | safe }}</li>
            {%- endfor %}
          </ul>
          {%- endif %}
        </div>
      </div>
      {%- endfor %}
    </div>
  </section>

  {{ mistakes(s) }}

  {{ nextSteps([
    [s.ctaPlayH, s.ctaPlayP, lang.path + "play/", s.ctaPlayBtn],
    [s.ctaRulesH, s.ctaRulesP, lang.path, s.ctaRulesBtn]
  ]) }}

  {% include "share.njk" %}
</main>

{% include "footer.njk" %}
