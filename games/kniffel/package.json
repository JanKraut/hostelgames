{
  "name": "@hostelgames/kniffel",
  "private": true,
  "description": "Kniffel – rules of the dice game and an online score sheet (draft)",
  "type": "module",
  "scripts": {
    "build": "npm run check && eleventy",
    "start": "eleventy --serve",
    "test": "playwright test",
    "check": "hostelgames-check-i18n --dir src/_data/i18n --templates src/index.njk,src/strategy.njk,src/quickstart.njk,src/scoresheet.njk,src/_includes/hero.njk --languages src/_data/languages.js"
  },
  "dependencies": {
    "@hostelgames/core": "*"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@playwright/test": "1.63.0"
  }
}
