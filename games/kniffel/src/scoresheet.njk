---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}scoresheet/"
layout: game
subpath: "scoresheet/"
scripts: ["/assets/scoresheet.js"]
eleventyComputed:
  pageTitle: "{{ lang.t.seo.sheetT }}"
  pageDescription: "{{ lang.t.seo.sheetD }}"
---
{#- Online-Block: Kniffel auf einem Gerät, gespeichert nur im Browser (localStorage).
    Rahmen und Ansichten kommen aus dem Core (sheet.njk), die Regeln aus assets/scoresheet.js.
    Feldnamen für den Eingabe-Dialog kommen aus den Regeltexten (up1–up6, lb_*H). -#}
{%- set r = lang.t.rules -%}
{%- set sheetExtra = { fields: {
  ones: r.up1, twos: r.up2, threes: r.up3, fours: r.up4, fives: r.up5, sixes: r.up6,
  three: r.lb_threeH, four: r.lb_fourH, full: r.lb_fullH, small: r.lb_smallH,
  large: r.lb_largeH, kniffel: r.lb_kniffelH, chance: r.lb_chanceH
} } -%}
{% include "sheet.njk" %}
