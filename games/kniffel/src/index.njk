---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}"
layout: game
share: true
eleventyComputed:
  pageTitle: "{{ lang.t.seo.rulesT }}"
  pageDescription: "{{ lang.t.seo.rulesD }}"
---
{%- from "blocks.njk" import secnav, steps, variants, faq, sheetCta -%}
{#- Regelseite, eine pro Sprache. Abschnitte von oben nach unten: Aufbau, Dein Zug,
    Oberer Block, Unterer Block, Punkte & Ende, Varianten, FAQ, Teilen. -#}
{%- from "dice.njk" import die, dice -%}
{%- set t = lang.t -%}
{%- set r = t.rules -%}
{% include "hero.njk" %}

{{ secnav(t.navLabel, [
  ["setup", r.nSetup],
  ["turn", r.nTurn],
  ["upper", r.nUpper],
  ["lower", r.nLower],
  ["scoring", r.nScoring],
  ["variants", r.nVar],
  ["faq", r.nFaq]
]) }}

<main class="wrap">

  <section id="setup">
    <h2>{{ r.setupH }}</h2>
    <p class="lead">{{ r.setupLead | safe }}</p>
    <ul class="rules">
      <li>{{ r.setup1 | safe }}</li>
      <li>{{ r.setup2 | safe }}</li>
      <li>{{ r.setup3 | safe }}</li>
    </ul>
    <p>{{ r.setupP | safe }}</p>
    {#- Hinweis auf den Online-Block (scoresheet/) -#}
    {{ sheetCta(lang.path + "scoresheet/", r.setupCta, r.setupCtaBtn) }}
  </section>

  <section id="turn">
    <h2>{{ r.turnH }}</h2>
    <p class="lead">{{ r.turnLead | safe }}</p>
    {{ steps(r, "s") }}

    {#- Beispielzug: Fünfen sammeln. Gold = beiseitegelegt. -#}
    <h3 class="sub">{{ r.exH }}</h3>
    <div class="rolls" role="img" aria-label="{{ r.exAlt }}">
      <div class="roll"><p class="roll-n">{{ r.exR1 }}</p>{{ dice([2, [5, "held"], [5, "held"], 1, [5, "held"]], "sm") }}</div>
      <div class="roll"><p class="roll-n">{{ r.exR2 }}</p>{{ dice([[5, "held"], [5, "held"], [5, "held"], 3, 6], "sm") }}</div>
      <div class="roll"><p class="roll-n">{{ r.exR3 }}</p>{{ dice([[5, "held"], [5, "held"], [5, "held"], [5, "held"], 2], "sm") }}</div>
    </div>
    <p>{{ r.exP | safe }}</p>

    <h3 class="sub">{{ r.strikeH }}</h3>
    <p>{{ r.strikeP | safe }}</p>
  </section>

  <section id="upper">
    <h2>{{ r.upH }}</h2>
    <p class="lead">{{ r.upLead | safe }}</p>
    <ul class="upper" role="list">
      {%- for n in range(1, 7) %}
      <li>
        {{ die(n, "xs") }}
        <b>{{ r["up" ~ n] }}</b>
        <span class="up-goal">3 × {{ n }} = {{ 3 * n }}</span>
      </li>
      {%- endfor %}
    </ul>
    <p>{{ r.upP | safe }}</p>
    <div class="bonus">
      <div class="bonus-n">+35</div>
      <p>{{ r.bonusP | safe }}</p>
    </div>
  </section>

  <section id="lower">
    <h2>{{ r.lowH }}</h2>
    <p class="lead">{{ r.lowLead | safe }}</p>
    {#- Name, Bedingung, Beispielwurf (gold = zählt), Punkte. -#}
    <div class="boxes">
      {%- for b in [
        ["three", [[4, "held"], [4, "held"], [4, "held"], 2, 6], "t"],
        ["four", [[6, "held"], [6, "held"], [6, "held"], [6, "held"], 1], "t"],
        ["full", [[3, "held"], [3, "held"], [3, "held"], [5, "held"], [5, "held"]], "25"],
        ["small", [[1, "held"], [2, "held"], [3, "held"], [4, "held"], 4], "30"],
        ["large", [[2, "held"], [3, "held"], [4, "held"], [5, "held"], [6, "held"]], "40"],
        ["kniffel", [[2, "held"], [2, "held"], [2, "held"], [2, "held"], [2, "held"]], "50"],
        ["chance", [6, 5, 3, 3, 1], "t"]
      ] %}
      <div class="box">
        <div class="box-head">
          <h3>{{ r["lb_" ~ b[0] ~ "H"] }}</h3>
          <span class="box-pts">{% if b[2] == "t" %}{{ r.ptsTotal }}{% else %}{{ b[2] }}{% endif %}</span>
        </div>
        <p>{{ r["lb_" ~ b[0] ~ "P"] | safe }}</p>
        {{ dice(b[1], "xs") }}
      </div>
      {%- endfor %}
    </div>
  </section>

  <section id="scoring">
    <h2>{{ r.scoreH }}</h2>
    <p class="lead">{{ r.scoreLead | safe }}</p>
    <ol class="sum">
      <li><span>{{ r.sum1 }}</span><b>{{ r.sum1v }}</b></li>
      <li><span>{{ r.sum2 }}</span><b>{{ r.sum2v }}</b></li>
      <li><span>{{ r.sum3 }}</span><b>{{ r.sum3v }}</b></li>
      <li class="total"><span>{{ r.sum4 }}</span><b>{{ r.sum4v }}</b></li>
    </ol>
    <h3 class="sub">{{ r.endH }}</h3>
    <p>{{ r.endP | safe }}</p>
  </section>

  {{ variants(r) }}

  {{ faq(r) }}

  {% include "share.njk" %}
</main>

{% include "footer.njk" %}
