---js
{
  // Error page for unknown addresses. English only, on purpose.
  permalink: "/404.html",
  layout: "game",
  notFound: true,
  eleventyExcludeFromCollections: true,
  eleventyComputed: {
    lang: (data) => data.languages[0],
    pageTitle: (data) => `${data.languages[0].t.nfT} · ${data.site.game.name}`,
    pageDescription: (data) => data.languages[0].t.nfH,
  },
}
---
{%- set t = lang.t -%}
<header class="hero">
  <div class="wrap">
    {% include "sitehead.njk" %}
    <h1>{{ t.nfH }}</h1>
    <p><a class="ctabtn" href="/">{{ t.nfBtn }}</a></p>
  </div>
</header>

{% include "footer.njk" %}
