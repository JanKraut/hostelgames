{#- Big header with title, intro, five dice and the goal. Shared by the rules page, the
    strategy page (own title and intro) and the quick start; only the rules page shows the fact sheet. -#}
{%- from "dice.njk" import die -%}
{%- set t = lang.t -%}
<header class="hero">
  <div class="wrap">
    {% include "sitehead.njk" %}
    {%- if subpath == "strategy/" %}
    <h1>{{ t.strategy.h1 | safe }}</h1>
    <p>{{ t.strategy.sub | safe }}</p>
    {%- else %}
    <h1>{{ t.h1 | safe }}<span class="h1-sub"> {{ t.h1sub }}</span></h1>
    <p>{{ t.sub | safe }}</p>
    {%- endif %}
    {#- Fünf Würfel, frisch geworfen: ein Kniffel aus Sechsen. -#}
    <div class="throw" aria-hidden="true">
      {%- for i in range(5) %}{{ die(6) }}{% endfor -%}
    </div>
    <div class="goal">
      <div class="goal-icon" aria-hidden="true">🎯</div>
      <p>{{ t.goal | safe }}</p>
    </div>
    {%- if not subpath %}
    {% include "factsheet.njk" %}
    {%- endif %}
  </div>
</header>
