{#- Dice for Kniffel (styles in assets/styles.css).
    die(n): one die showing n (1–6). size: "" | "sm" | "xs"; extra: more classes,
    e.g. "held" (kept aside, gold outline) or "dim" (not counted). -#}
{% macro die(n, size="", extra="") -%}
{#- Pip positions 1–9 in the 3 × 3 grid (row by row) for the faces 1 to 6. -#}
{%- set pips = [[5], [3, 7], [3, 5, 7], [1, 3, 7, 9], [1, 3, 5, 7, 9], [1, 3, 4, 6, 7, 9]][n - 1] -%}
<span class="die{% if size %} {{ size }}{% endif %}{% if extra %} {{ extra }}{% endif %}" data-n="{{ n }}">
  {%- for i in range(1, 10) %}<i{% if i in pips %} class="p"{% endif %}></i>{% endfor -%}
</span>
{%- endmacro %}

{#- A row of dice. Items are numbers or [n, extra]. -#}
{% macro dice(list, size="") -%}
<span class="dicerow">
  {%- for d in list %}{% if d.length %}{{ die(d[0], size, d[1]) }}{% else %}{{ die(d, size) }}{% endif %}{% endfor -%}
</span>
{%- endmacro %}
