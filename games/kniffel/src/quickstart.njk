---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}quickstart/"
layout: game
subpath: "quickstart/"
share: true
eleventyComputed:
  pageTitle: "{{ lang.t.seo.quickT }}"
  pageDescription: "{{ lang.t.seo.quickD }}"
---
{#- Quickstart: Spickzettel, der auf einen Handybildschirm passt – Ablauf, oberer Block mit
    Soll und Bonus, unterer Block mit Punkten. Danach Link zum Online-Block. Texte unter `quick`,
    Feldnamen wie auf der Regelseite (up1–up6, lb_*H). -#}
{%- from "dice.njk" import die, dice -%}
{%- set t = lang.t -%}
{%- set k = t.quick -%}
{% include "hero.njk" %}

<main class="wrap quick">
  <section id="cheat-sheet">
    <div class="cheat cheat2">
      <h2>{{ k.h }}</h2>

      <div class="ch-block ch-rule">
        <div class="ch-icon" aria-hidden="true">3×</div>
        <div><h3>{{ k.ruleH }}</h3><p>{{ k.rule | safe }}</p></div>
      </div>

      <div class="ch-block">
        <h3>{{ t.upH }}</h3>
        <ul class="ch-upper" role="list">
          {%- for n in range(1, 7) %}
          <li>{{ die(n, "xs") }}<span>{{ t["up" ~ n] }}</span><b>{{ 3 * n }}</b></li>
          {%- endfor %}
        </ul>
        <p>{{ k.upper | safe }}</p>
      </div>

      <div class="ch-block">
        <h3>{{ t.lowH }}</h3>
        <ul class="ch-lower" role="list">
          {%- for b in [
            ["three", [4, 4, 4, 2, 6], "Σ"],
            ["four", [6, 6, 6, 6, 1], "Σ"],
            ["full", [3, 3, 3, 5, 5], "25"],
            ["small", [1, 2, 3, 4, 4], "30"],
            ["large", [2, 3, 4, 5, 6], "40"],
            ["kniffel", [2, 2, 2, 2, 2], "50"],
            ["chance", [6, 5, 3, 3, 1], "Σ"]
          ] %}
          <li><span>{{ t["lb_" ~ b[0] ~ "H"] }}</span>{{ dice(b[1], "fs") }}<b>{{ b[2] }}</b></li>
          {%- endfor %}
        </ul>
        <p class="ch-legend">{{ k.sigma | safe }}</p>
      </div>

      <div class="ch-block ch-rule">
        <div class="ch-icon" aria-hidden="true">0</div>
        <div><h3>{{ t.strikeH }}</h3><p>{{ k.strike | safe }}</p></div>
      </div>
    </div>
  </section>

  <section id="next-steps" class="ctas">
    <div class="cta">
      <h2>{{ k.ctaSheetH }}</h2>
      <p>{{ k.ctaSheetP }}</p>
      <a class="ctabtn" href="{{ lang.path }}scoresheet/">{{ t.setupCtaBtn }} →</a>
    </div>
    <div class="cta">
      <h2>{{ k.ctaStratH }}</h2>
      <p>{{ k.ctaStratP }}</p>
      <a class="ctabtn" href="{{ lang.path }}strategy/">{{ k.ctaStratBtn }} →</a>
    </div>
  </section>

  {% include "share.njk" %}
</main>

{% include "footer.njk" %}
