{
  "name": "hostelgames",
  "private": true,
  "description": "Hostel Games – card games from every hostel in the world. Monorepo: shared core, one folder per game.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*",
    "hub"
  ],
  "scripts": {
    "build": "node scripts/build-all.js",
    "build:shithead": "npm run build -w @hostelgames/shithead",
    "build:asshole": "npm run build -w @hostelgames/asshole",
    "build:cabo": "npm run build -w @hostelgames/cabo",
    "build:cambio": "npm run build -w @hostelgames/cambio",
    "build:president": "npm run build -w @hostelgames/president",
    "build:kniffel": "npm run build -w @hostelgames/kniffel",
    "start:shithead": "npm start -w @hostelgames/shithead",
    "start:asshole": "npm start -w @hostelgames/asshole",
    "start:cabo": "npm start -w @hostelgames/cabo",
    "start:cambio": "npm start -w @hostelgames/cambio",
    "start:president": "npm start -w @hostelgames/president",
    "start:kniffel": "npm start -w @hostelgames/kniffel",
    "start:hub": "npm start -w @hostelgames/hub",
    "check": "npm run check --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "serve": "node packages/core/scripts/serve.js _site /hostelgames/"
  }
}
