{#- Web analytics in <head>, configured in src/_data/tracking.js. Empty when tracking is off. -#}
{%- if tracking.provider == "gtm" %}
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}dataLayer.push({"gtm.start":new Date().getTime(),event:"gtm.js"});</script>
<script async src="https://www.googletagmanager.com/gtm.js?id={{ tracking.id }}"></script>
{%- elif tracking.provider == "ga4" %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ tracking.id }}"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag("js",new Date());gtag("config","{{ tracking.id }}");</script>
{%- elif tracking.provider == "matomo" %}
<script>var _paq=window._paq=window._paq||[];_paq.push(["trackPageView"]);_paq.push(["enableLinkTracking"]);(function(){var u="{{ tracking.matomoUrl }}";_paq.push(["setTrackerUrl",u+"matomo.php"]);_paq.push(["setSiteId","{{ tracking.id }}"]);var g=document.createElement("script");g.async=true;g.src=u+"matomo.js";document.head.appendChild(g)})();</script>
{%- endif %}
