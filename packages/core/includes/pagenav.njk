{#- Tabs between the main pages of a game: rules, strategy, quick start, score sheet – only those in
    "pages" of its game.json and in that order (the game against bots is not a tab), shown only with
    more than one. The current one is marked via `subpath`. If they don't fit, the bar scrolls sideways
    (core.css, core.js). Texts from the game's i18n: pgLabel, pgRules, n6 (strategy), pgQuick,
    pgSheet (online score sheet). -#}
{%- set here = subpath or "" -%}
{%- set t = lang.t -%}
{%- set gamePages = site.game.pages if (site.game and site.game.pages) else ["rules", "strategy", "quickstart"] -%}
{%- set tabs = [] -%}
{%- set known = { "rules": ["", t.pgRules], "strategy": ["strategy/", t.n6], "quickstart": ["quickstart/", t.pgQuick], "scoresheet": ["scoresheet/", t.pgSheet] } -%}
{%- for name in gamePages -%}
{%- if known[name] %}{% set tabs = (tabs.push([name, known[name][0], known[name][1]]), tabs) %}{% endif -%}
{%- endfor -%}
{#- A single page needs no tabs. -#}
{%- if tabs.length > 1 %}
<nav class="pagetabs" aria-label="{{ t.pgLabel }}">
  <ul>
    {%- for p in tabs %}
    <li><a href="{{ lang.path }}{{ p[1] }}"{% if p[1] == here %} aria-current="page"{% endif %}>{{ p[2] }}</a></li>
    {%- endfor %}
  </ul>
</nav>
{%- endif %}
