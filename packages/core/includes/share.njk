{#- "Share the guide" box with QR code. Points to the page it is on.
    Pages that include it set `share: true` in their front matter; the layout then loads
    /assets/core/qrcode.js right away. The QR button at the top of every page opens the same
    box as a popup (sitehead.njk).
    Texts from the game's i18n: shH, shLead, shAlt, shBtn, shCopy, shCopied, shClose. -#}
{%- from "sharebox.njk" import sharebox -%}
{%- set t = lang.t -%}
<section id="share">
  <div class="sharebox">
    {{ sharebox(t, lang.url + (subpath or ""), true) }}
  </div>
</section>

