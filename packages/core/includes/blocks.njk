{#- Building blocks of the game pages (styles in core.css). Import what a page needs:
      {%- from "blocks.njk" import secnav, steps, variants, faq, strats, mistakes, nextSteps, sheetCta -%}
    The lists end with the last text that exists: one more FAQ, variant or step is only a
    new text in the game's i18n (faq9q + faq9a, var12, s5h + s5p …), no change to the page. -#}

{#- Section navigation below the header. items: [["setup", r.nSetup], ["faq", r.nFaq], …] (r = t.rules)
    Targets starting with "/" or "#" are used as href directly (e.g. a link to another page);
    otherwise "#" is prepended. An optional third element sets a CSS class on the <li>. -#}
{% macro secnav(label, items) -%}
<nav class="secnav" aria-label="{{ label }}">
  <ul>
    {%- for item in items %}
    {%- set target = item[0] %}
    <li{% if item[2] %} class="{{ item[2] }}"{% endif %}><a href="{% if target[0] == '/' or target[0] == '#' %}{{ target }}{% else %}#{{ target }}{% endif %}">{{ item[1] }}</a></li>
    {%- endfor %}
  </ul>
</nav>
{%- endmacro %}

{#- Numbered steps: texts[prefix + n + "h"] (heading) and texts[prefix + n + "p"] (text), n = 1, 2, … -#}
{% macro steps(texts, prefix) -%}
<ol class="steps">
  {%- for n in range(1, 40) %}{% if texts[prefix ~ n ~ "h"] %}
  <li><h3>{{ texts[prefix ~ n ~ "h"] }}</h3><p>{{ texts[prefix ~ n ~ "p"] | safe }}</p></li>
  {%- endif %}{% endfor %}
</ol>
{%- endmacro %}

{#- Section "Variants": texts.varH, texts.varLead (optional), texts.var1, var2, … -#}
{% macro variants(texts, id="variants") -%}
<section id="{{ id }}">
  <h2>{{ texts.varH }}</h2>
  {%- if texts.varLead %}
  <p class="lead">{{ texts.varLead | safe }}</p>
  {%- endif %}
  <ul class="variants">
    {%- for n in range(1, 40) %}{% if texts["var" ~ n] %}
    <li>{{ texts["var" ~ n] | safe }}</li>
    {%- endif %}{% endfor %}
  </ul>
</section>
{%- endmacro %}

{#- Section "FAQ": texts.faqH, texts.faq1q + faq1a, faq2q + faq2a, … (answers open on tap, no JavaScript) -#}
{% macro faq(texts, id="faq") -%}
<section id="{{ id }}">
  <h2>{{ texts.faqH }}</h2>
  <div class="faq">
    {%- for n in range(1, 40) %}{% if texts["faq" ~ n ~ "q"] %}
    <details>
      <summary>{{ texts["faq" ~ n ~ "q"] }}</summary>
      <p>{{ texts["faq" ~ n ~ "a"] | safe }}</p>
    </details>
    {%- endif %}{% endfor %}
  </div>
</section>
{%- endmacro %}

{#- Strategy tip list: items is an array of HTML strings (e.g. s.openTips). -#}
{% macro strats(items) -%}
<ul class="strats">
  {%- for item in items %}
  <li><p>{{ item | safe }}</p></li>
  {%- endfor %}
</ul>
{%- endmacro %}

{#- Section "Common mistakes": texts.mistakesH and texts.mistakes (array of HTML strings). -#}
{% macro mistakes(texts, id="mistakes") -%}
<section id="{{ id }}">
  <h2>{{ texts.mistakesH }}</h2>
  <ul class="variants">
    {%- for item in texts.mistakes %}
    <li>{{ item | safe }}</li>
    {%- endfor %}
  </ul>
</section>
{%- endmacro %}

{#- Next-step CTA cards: items is [[heading, text, href, buttonLabel], …].
    Two or more cards get the two-column .ctas grid; a single card renders without it. -#}
{% macro nextSteps(items, id="next-steps") -%}
<section id="{{ id }}"{% if items.length > 1 %} class="ctas"{% endif %}>
  {%- for item in items %}
  <div class="cta">
    <h2>{{ item[0] }}</h2>
    <p>{{ item[1] }}</p>
    <a class="ctabtn go" href="{{ item[2] }}">{{ item[3] }}<span class="go-ic" aria-hidden="true"></span></a>
  </div>
  {%- endfor %}
</section>
{%- endmacro %}

{#- Compact inline CTA box linking to the online score sheet (rules pages). -#}
{% macro sheetCta(href, text, btn) -%}
<div class="cta sheet-cta">
  <p>{{ text }}</p>
  <a class="ctabtn" href="{{ href }}">{{ btn }}</a>
</div>
{%- endmacro %}
