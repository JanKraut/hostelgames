{#- Frame for every page of a game, from @hostelgames/core (`layout: game`, alias set by the core plugin).
    Pages set: subpath ("" or "strategy/" …), pageTitle, pageDescription, and optionally
    share (true: share box with QR code at the bottom, loads qrcode.js right away), styles, classicScripts and scripts (ES modules) as
    lists of /assets/… paths, notFound (404 page).
    The game's own /assets/styles.css is always loaded after core.css. Name, languages, pages and
    optional alternateName come from game.json (site.game). Optional files detected by the core plugin
    (siteFiles): src/favicon.ico, src/manifest.webmanifest, src/assets/apple-touch-icon.png,
    src/assets/og-image.png and src/assets/site.js. -#}
{%- set sub = subpath or "" -%}
{%- set game = site.game -%}
<!DOCTYPE html>
<html lang="{{ lang.htmlLang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
{#- Previews (GitHub Pages) and drafts are never listed by search engines, nor is the 404 page. #}
{%- if not site.indexable or game.status != "live" or notFound %}
<meta name="robots" content="noindex">
{%- endif %}
{%- if not notFound %}
<link rel="canonical" href="{{ lang.url }}{{ sub }}">
{%- for l in languages %}
<link rel="alternate" hreflang="{{ l.htmlLang }}" href="{{ l.url }}{{ sub }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ languages[0].url }}{{ sub }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ game.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ lang.url }}{{ sub }}">
{%- set ogImg = ogImage or (siteFiles and siteFiles.ogImage) -%}
{%- if ogImg %}
<meta property="og:image" content="{{ site.origin }}{{ site.pathPrefix }}{{ ogImg }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ game.name }}">
<meta name="twitter:card" content="summary_large_image">
{%- endif %}
{%- if lang.code == "en" and sub == "" %}
{%- set langList = [] %}{% for l in languages %}{% set langList = (langList.push(l.htmlLang), langList) %}{% endfor %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": game.name,
  "alternateName": game.alternateName,
  "url": site.origin + site.pathPrefix,
  "description": pageDescription,
  "inLanguage": langList,
  "publisher": { "@type": "Organization", "name": "Mut im Rucksack", "url": "https://mut-im-rucksack.de/" }
} | dump | safe }}</script>
{%- endif %}
{%- endif %}
<script>document.documentElement.classList.add("js");try{var th=localStorage.getItem("theme");if(th==="light"||th==="dark")document.documentElement.dataset.theme=th}catch(e){}</script>
{%- if lang.path == "/" and not notFound %}
<script>{% include "redirect.njk" %}</script>
{%- endif %}
{%- include "tracking-head.njk" %}
<meta name="theme-color" content="#f4cf71" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#171a1f" media="(prefers-color-scheme: dark)">
{%- if siteFiles and siteFiles.faviconIco %}
<link rel="icon" href="/favicon.ico" sizes="48x48">
{%- endif %}
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
{%- if siteFiles and siteFiles.appleTouchIcon %}
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
{%- endif %}
{%- if siteFiles and siteFiles.manifest %}
<link rel="manifest" href="/manifest.webmanifest">
{%- endif %}
{%- for file in coreFonts %}
<link rel="preload" href="/assets/core/fonts/{{ file }}" as="font" type="font/woff2" crossorigin>
{%- endfor %}
<link rel="stylesheet" href="/assets/core/fonts.css?v={{ assetVersion }}">
<link rel="stylesheet" href="/assets/core/core.css?v={{ assetVersion }}">
<link rel="stylesheet" href="/assets/styles.css?v={{ assetVersion }}">
{%- for href in styles %}
<link rel="stylesheet" href="{{ href }}?v={{ assetVersion }}">
{%- endfor %}
{%- if share %}
<script src="/assets/core/qrcode.js?v={{ assetVersion }}" defer></script>
{%- endif %}
{%- for src in classicScripts %}
<script src="{{ src }}?v={{ assetVersion }}" defer></script>
{%- endfor %}
<script type="module" src="/assets/core/core.js?v={{ assetVersion }}"></script>
{%- if siteFiles and siteFiles.siteScript %}
<script type="module" src="/assets/site.js?v={{ assetVersion }}"></script>
{%- endif %}
<script type="module" src="/assets/core/share.js?v={{ assetVersion }}"></script>
{%- for src in scripts %}
<script type="module" src="{{ src }}?v={{ assetVersion }}"></script>
{%- endfor %}
</head>
<body>
{%- include "tracking-body.njk" %}
{{ content | safe }}
</body>
</html>
