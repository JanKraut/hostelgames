{#- Fact sheet in the header of the rules page (hero.njk): luck/skill scales, players, playing time,
    similar games, what you need, introduction. Shown when game.json has "factsheet":
      "factsheet": { "scales": [["luck", "skill", 35], ["easy", "complex", 20], ["kids", "adults", 15]],
                     "people": [1, 2] }
    scales: two `info` text keys and a value 0–100; people: people in the icon of the two player
    groups (1–3); id: anchor of the section (default "factsheet").
    Texts: `info` in the game's i18n (labels from the core's standard texts).
    Parts a game can replace with a file of the same name in its own _includes:
      factsheet-players.njk  the two player groups (default: icon, count, mode1 / mode2)
      factsheet-gear.njk     the box "What you need" (default: gearH, the picture, gearN)
      factsheet-art.njk      only the picture in that box (dice, cards …) -#}
{%- set i = lang.t.info -%}
{%- set fs = site.game.factsheet -%}
<section id="{{ fs.id or 'factsheet' }}" class="factsheet" aria-label="{{ i.label }}">
  <div class="fs-grid">
    <div class="fs-box fs-scales">
      {%- for s in fs.scales %}
      <div class="fs-scale" role="img" aria-label="{{ i[s[0]] }} – {{ i[s[1]] }}">
        <span>{{ i[s[0]] }}</span><span class="fs-bar" style="--v: {{ s[2] }}%" aria-hidden="true"></span><span>{{ i[s[1]] }}</span>
      </div>
      {%- endfor %}
    </div>

    <div class="fs-box">
      <h2>{{ i.playersH }}</h2>
      <div class="fs-players">
        {%- include "factsheet-players.njk" %}
      </div>
    </div>

    <div class="fs-box fs-pair">
      <div>
        <h2>{{ i.timeH }}</h2>
        <div class="fs-clock"><b>{{ i.timeN }}</b><small>{{ i.timeU }}</small></div>
      </div>
      <div>
        <h2>{{ i.similarH }}</h2>
        <ul class="fs-similar">
          {%- for name in i.similar.split(", ") %}
          <li>{{ name }}</li>
          {%- endfor %}
        </ul>
      </div>
    </div>

    {% include "factsheet-gear.njk" %}
  </div>

  <div class="fs-intro">
    <h2>{{ i.introH }}</h2>
    <p>{{ i.intro | safe }}</p>
  </div>
</section>
