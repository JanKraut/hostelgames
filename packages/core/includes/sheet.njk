{#- Online score sheet: the body of every game's scoresheet.njk (the game's page sets the front matter
    and includes this). Three views, switched by the game's assets/scoresheet.js (./core/scoresheet.js):
    new game (#sheet-setup), sheet (#sheet-game), final score (#sheet-result). Table, lists and the input
    dialog are built by the script. Texts: `sheet` of the game (core standard texts underneath).
    A page can pass extra texts to the script as `sheetExtra` (an object), set before the include. -#}
{%- set t = lang.t -%}
{%- set s = t.sheet -%}
<header class="hero hero-small">
  <div class="wrap">
    {% include "sitehead.njk" %}
    <h1>{{ s.h1 }}</h1>
    <p>{{ s.sub }}</p>
  </div>
</header>

<main class="wrap sheet" id="sheet">
  <noscript><p class="sheet-note">{{ s.noJs }}</p></noscript>

  <section id="sheet-setup" class="js-only" aria-labelledby="sheet-setup-h">
    <h2 id="sheet-setup-h">{{ s.newH }}</h2>
    <form class="sheet-card" id="sheet-form">
      <h3 class="sheet-players-h" id="sheet-players-h"></h3>
      <ol class="sheet-players" id="sheet-players"></ol>
      <button type="button" class="sheet-add" id="sheet-add">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        {{ s.add }}
      </button>
      <div class="sheet-options" id="sheet-options" hidden></div>
      <button type="submit" class="ctabtn sheet-primary">{{ s.start }}</button>
    </form>
    <div id="sheet-recent" hidden>
      <h3>{{ s.recentH }}</h3>
      <ul class="sheet-recent" id="sheet-recent-list"></ul>
    </div>
    <p class="sheet-note">{{ s.storageNote }}</p>
  </section>

  <section id="sheet-game" hidden aria-label="{{ s.h1 }}">
    <p class="sheet-round" id="sheet-round" aria-live="polite"></p>
    <div class="sheet-scroll">
      <table class="sheet-table" id="sheet-table"></table>
    </div>
    <div class="sheet-extra" id="sheet-extra"></div>
    <p class="sheet-note sheet-saved">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
      {{ s.saved }}
    </p>
    <div class="sheet-actions">
      <button type="button" class="sheet-btn" id="sheet-undo">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/></svg>
        {{ s.undo }}
      </button>
      <button type="button" class="ctabtn sheet-primary" id="sheet-finish">{{ s.finish }}</button>
    </div>
    <p class="sheet-links"><button type="button" class="sheet-link" id="sheet-new">{{ s.newGame }}</button></p>
  </section>

  <section id="sheet-result" hidden aria-labelledby="sheet-result-h">
    <h2 id="sheet-result-h" tabindex="-1">{{ s.resultH }}</h2>
    <div class="sheet-winner" id="sheet-winner"></div>
    <ol class="sheet-ranking" id="sheet-ranking"></ol>
    <div class="sheet-actions sheet-actions-col">
      <button type="button" class="ctabtn sheet-primary" id="sheet-again">{{ s.again }}</button>
      <button type="button" class="sheet-btn" id="sheet-back">{{ s.back }}</button>
      <button type="button" class="sheet-btn" id="sheet-all">{{ s.allGames }}</button>
    </div>
  </section>

  {#- Input for one entry: the content is built by the game's script. -#}
  <dialog class="sheet-dialog" id="sheet-dialog" aria-labelledby="sheet-dialog-h">
    <form method="dialog" id="sheet-dialog-form">
      <p class="sheet-dialog-player" id="sheet-dialog-player"></p>
      <h2 id="sheet-dialog-h"></h2>
      <p class="sheet-dialog-q" id="sheet-dialog-q"></p>
      <div id="sheet-dialog-body"></div>
      <p class="sheet-dialog-error" id="sheet-dialog-error" role="alert"></p>
      <div class="sheet-dialog-actions" id="sheet-dialog-actions"></div>
      <button type="button" class="sheet-link" id="sheet-dialog-cancel">{{ s.cancel }}</button>
    </form>
  </dialog>
</main>

<script type="application/json" id="sheet-texts">{{ { lang: lang.code, t: s, extra: sheetExtra or {} } | dump | safe }}</script>

{% include "footer.njk" %}
